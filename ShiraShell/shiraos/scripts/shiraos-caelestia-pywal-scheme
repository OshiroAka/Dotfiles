#!/usr/bin/env bash
set -u

# shiraos-caelestia-pywal-scheme v4
#
# v4 muda a estratégia:
# - escreve o scheme em vários caminhos prováveis do Caelestia;
# - tenta aplicar com várias formas do CLI;
# - mostra o último erro do CLI no status.
#
# Uso:
#   shiraos-caelestia-pywal-scheme --prepare --apply --allow-sudo --force --no-terminal --attempts 3
#   shiraos-caelestia-pywal-scheme --status

PREPARE=0
APPLY=0
STATUS=0
ALLOW_SUDO=0
FORCE=0
NO_TERMINAL=0
ATTEMPTS=1

SLOT_NAME="${SHIRAOS_CAEL_SLOT_NAME:-dynamic}"
MODE="${SHIRAOS_CAEL_MODE:-dark}"
USER_NAME="${SUDO_USER:-${USER:-$(id -un)}}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6 2>/dev/null || printf '%s' "$HOME")"
STATE_DIR="${XDG_STATE_HOME:-$USER_HOME/.local/state}/shiraos"
LAST_CLI_LOG="$STATE_DIR/caelestia-scheme-apply.log"

mkdir -p "$STATE_DIR" 2>/dev/null || true

ok()   { printf '✓ %s\n' "$*"; }
warn() { printf '⚠ %s\n' "$*" >&2; }
fail() { printf '✘ %s\n' "$*" >&2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prepare) PREPARE=1 ;;
    --apply) APPLY=1 ;;
    --status) STATUS=1 ;;
    --allow-sudo) ALLOW_SUDO=1 ;;
    --force) FORCE=1 ;;
    --no-terminal) NO_TERMINAL=1 ;;
    --attempts)
      shift
      ATTEMPTS="${1:-1}"
      ;;
    --attempts=*)
      ATTEMPTS="${1#*=}"
      ;;
    -h|--help)
      cat <<EOF
Uso:
  $0 --prepare --apply --allow-sudo --force --no-terminal --attempts 3
  $0 --status
EOF
      exit 0
      ;;
    *)
      warn "Ignorando opção desconhecida: $1"
      ;;
  esac
  shift
done

is_system_path() {
  [[ "$1" == /etc/* || "$1" == /usr/* || "$1" == /opt/* ]]
}

make_dir() {
  local dir="$1"
  if is_system_path "$dir"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo install -d "$dir"
    else
      mkdir -p "$dir"
    fi
  else
    mkdir -p "$dir"
  fi
}

copy_to_path() {
  local src="$1"
  local dest="$2"
  if is_system_path "$dest"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo cp "$src" "$dest"
    else
      cp "$src" "$dest"
    fi
  else
    cp "$src" "$dest"
  fi
}

fix_slot_perms() {
  local slot="$1"

  if is_system_path "$slot"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo chown "$USER_NAME:$USER_NAME" "$slot" 2>/dev/null || true
      sudo chmod 664 "$slot" 2>/dev/null || true
    else
      chmod 664 "$slot" 2>/dev/null || true
    fi
  else
    chown "$USER_NAME:$USER_NAME" "$slot" 2>/dev/null || true
    chmod 664 "$slot" 2>/dev/null || true
  fi
}

pywal_source() {
  for f in \
    "$USER_HOME/.cache/wal/colors" \
    "$USER_HOME/.cache/wal/colors.json" \
    "$USER_HOME/.cache/wal/colors.sh"
  do
    [[ -s "$f" ]] && {
      printf '%s\n' "$f"
      return 0
    }
  done
  return 1
}

candidate_scheme_dirs() {
  local root=""

  # Mais provável para a adaptação via Quickshell.
  printf '%s\n' "$USER_HOME/.config/quickshell/caelestia/schemes"

  # Possíveis caminhos do CLI/python do Caelestia.
  printf '%s\n' "$USER_HOME/.config/caelestia/schemes"
  printf '%s\n' "$USER_HOME/.local/share/caelestia/schemes"
  printf '%s\n' "$USER_HOME/.local/state/caelestia/schemes"

  # Possíveis caminhos globais.
  printf '%s\n' "/etc/xdg/quickshell/caelestia/schemes"
  printf '%s\n' "/etc/xdg/caelestia/schemes"
  printf '%s\n' "/usr/share/quickshell/caelestia/schemes"
  printf '%s\n' "/usr/share/caelestia/schemes"

  # Se uma raiz existe com pastas de scheme alternativas, inclui.
  for root in \
    "$USER_HOME/.config/quickshell/caelestia" \
    "/etc/xdg/quickshell/caelestia" \
    "/usr/share/quickshell/caelestia"
  do
    [[ -d "$root" ]] || continue
    printf '%s\n' "$root/scheme"
    printf '%s\n' "$root/assets/schemes"
    printf '%s\n' "$root/assets/scheme"
    printf '%s\n' "$root/services/schemes"
  done
}

existing_template_scheme() {
  local file=""
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    file="$(find "$dir" -maxdepth 2 -type f -name '*.json' ! -name "$SLOT_NAME.json" 2>/dev/null | head -n 1 || true)"
    [[ -n "$file" ]] && {
      printf '%s\n' "$file"
      return 0
    }
  done < <(candidate_scheme_dirs)
  return 1
}

generate_scheme_json() {
  local template="$1"
  local out="$2"

  USER_HOME="$USER_HOME" SLOT_NAME="$SLOT_NAME" MODE="$MODE" TEMPLATE="$template" OUT="$out" python3 - <<'PY'
import json
import os
import re
from pathlib import Path

home = Path(os.environ["USER_HOME"])
slot_name = os.environ.get("SLOT_NAME", "dynamic")
mode = os.environ.get("MODE", "dark")
template_path = os.environ.get("TEMPLATE", "")
out_path = Path(os.environ["OUT"])

def read_pywal_colors():
    colors_file = home / ".cache/wal/colors"
    if colors_file.exists():
        vals = []
        for line in colors_file.read_text(errors="ignore").splitlines():
            line = line.strip()
            if re.match(r"^#[0-9a-fA-F]{6}$", line):
                vals.append(line)
        if vals:
            while len(vals) < 16:
                vals.append(vals[-1])
            return vals[:16]

    colors_json = home / ".cache/wal/colors.json"
    if colors_json.exists():
        try:
            data = json.loads(colors_json.read_text(errors="ignore"))
            vals = []
            special = data.get("special", {})
            colors = data.get("colors", {})
            for key in ["background", "foreground", "cursor"]:
                v = special.get(key)
                if isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                    vals.append(v)
            for i in range(16):
                v = colors.get(f"color{i}")
                if isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                    vals.append(v)
            if vals:
                while len(vals) < 16:
                    vals.append(vals[-1])
                return vals[:16]
        except Exception:
            pass

    colors_sh = home / ".cache/wal/colors.sh"
    if colors_sh.exists():
        vals = re.findall(r"#[0-9a-fA-F]{6}", colors_sh.read_text(errors="ignore"))
        if vals:
            while len(vals) < 16:
                vals.append(vals[-1])
            return vals[:16]

    return [
        "#11111b", "#313244", "#f38ba8", "#a6e3a1",
        "#f9e2af", "#89b4fa", "#cba6f7", "#94e2d5",
        "#bac2de", "#45475a", "#f38ba8", "#a6e3a1",
        "#f9e2af", "#89b4fa", "#cba6f7", "#cdd6f4",
    ]

c = read_pywal_colors()
bg = c[0]
surface = c[1] if len(c) > 1 else bg
red = c[2] if len(c) > 2 else "#f38ba8"
green = c[3] if len(c) > 3 else "#a6e3a1"
yellow = c[4] if len(c) > 4 else "#f9e2af"
blue = c[5] if len(c) > 5 else "#89b4fa"
purple = c[6] if len(c) > 6 else "#cba6f7"
cyan = c[7] if len(c) > 7 else "#94e2d5"
fg = c[15] if len(c) > 15 else (c[7] if len(c) > 7 else "#cdd6f4")
accent = blue

base = None
if template_path and Path(template_path).exists():
    try:
        base = json.loads(Path(template_path).read_text(errors="ignore"))
    except Exception:
        base = None

if not isinstance(base, dict):
    base = {}

base["name"] = slot_name
base["flavour"] = mode
base["mode"] = mode

roles = {
    "background": bg, "bg": bg, "base": bg,
    "foreground": fg, "fg": fg, "text": fg,
    "surface": surface, "surface0": surface, "mantle": surface, "crust": bg,
    "accent": accent, "primary": accent, "border": accent,
    "red": red, "green": green, "yellow": yellow, "blue": blue,
    "purple": purple, "pink": purple, "mauve": purple,
    "cyan": cyan, "teal": cyan, "orange": yellow,
}

def update_obj(obj):
    if isinstance(obj, dict):
        for k, v in list(obj.items()):
            lk = str(k).lower().replace("_", "").replace("-", "")
            if isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                for role, val in roles.items():
                    rk = role.lower().replace("_", "").replace("-", "")
                    if lk == rk or rk in lk:
                        obj[k] = val
                        break
            else:
                update_obj(v)
    elif isinstance(obj, list):
        for item in obj:
            update_obj(item)

update_obj(base)

# Escreve múltiplos nomes para cobrir versões que esperam colours/colors/palette.
for section in ["colours", "colors", "palette"]:
    if not isinstance(base.get(section), dict):
        base[section] = {}
    base[section].update({
        "background": bg,
        "foreground": fg,
        "bg": bg,
        "fg": fg,
        "text": fg,
        "surface": surface,
        "surface0": surface,
        "base": bg,
        "accent": accent,
        "primary": accent,
        "border": accent,
        "red": red,
        "green": green,
        "yellow": yellow,
        "blue": blue,
        "purple": purple,
        "pink": purple,
        "cyan": cyan,
        "teal": cyan,
    })

out_path.write_text(json.dumps(base, indent=2, ensure_ascii=False) + "\n")
PY
}

prepare_slot_once() {
  local template tmp dir slot prepared=0

  template="$(existing_template_scheme || true)"
  tmp="$(mktemp)"
  generate_scheme_json "$template" "$tmp"

  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue

    # Evita criar coisas globais sem --allow-sudo.
    if is_system_path "$dir" && [[ "$ALLOW_SUDO" -ne 1 ]]; then
      continue
    fi

    make_dir "$dir" || continue
    slot="$dir/$SLOT_NAME.json"
    copy_to_path "$tmp" "$slot" || continue
    fix_slot_perms "$slot"

    if [[ -f "$slot" ]]; then
      prepared=$((prepared + 1))
    fi
  done < <(candidate_scheme_dirs | awk '!seen[$0]++')

  rm -f "$tmp"

  if [[ "$prepared" -gt 0 ]]; then
    ok "Slots preparados: $prepared"
    return 0
  fi

  warn "Nenhum slot foi preparado."
  return 1
}

try_caelestia_cmd() {
  local desc="$1"
  shift

  {
    echo ">>> $desc"
    printf 'cmd:'
    printf ' %q' "$@"
    echo
    "$@"
  } >> "$LAST_CLI_LOG" 2>&1
}

apply_scheme_once() {
  : > "$LAST_CLI_LOG"

  if ! command -v caelestia >/dev/null 2>&1; then
    warn "Comando caelestia não encontrado; prepare foi feito, apply foi pulado."
    return 0
  fi

  # Tenta variações comuns. Algumas versões aceitam --notify, outras não.
  try_caelestia_cmd "set notify name mode" caelestia scheme set --notify -n "$SLOT_NAME" -m "$MODE" && {
    ok "Scheme aplicado: $SLOT_NAME ($MODE)"
    return 0
  }

  try_caelestia_cmd "set name mode notify" caelestia scheme set -n "$SLOT_NAME" -m "$MODE" --notify && {
    ok "Scheme aplicado: $SLOT_NAME ($MODE)"
    return 0
  }

  try_caelestia_cmd "set name mode" caelestia scheme set -n "$SLOT_NAME" -m "$MODE" && {
    ok "Scheme aplicado: $SLOT_NAME ($MODE)"
    return 0
  }

  try_caelestia_cmd "set name" caelestia scheme set -n "$SLOT_NAME" && {
    ok "Scheme aplicado: $SLOT_NAME"
    return 0
  }

  try_caelestia_cmd "set positional" caelestia scheme set "$SLOT_NAME" && {
    ok "Scheme aplicado: $SLOT_NAME"
    return 0
  }

  warn "Não consegui aplicar via Caelestia CLI."
  warn "Log do CLI: $LAST_CLI_LOG"
  tail -20 "$LAST_CLI_LOG" 2>/dev/null | sed 's/^/  /' >&2 || true
  return 0
}

status_slot() {
  local pywal_file template count writable_any="False" slot

  pywal_file="$(pywal_source || true)"
  template="$(existing_template_scheme || true)"

  echo "Slot name: $SLOT_NAME"
  echo "Mode: $MODE"
  echo "Template scheme: ${template:-None}"
  echo "Pywal colors: $([[ -n "$pywal_file" ]] && echo True || echo False)"
  echo "Pywal source: ${pywal_file:-None}"
  echo "Caelestia CLI: $(command -v caelestia >/dev/null 2>&1 && echo True || echo False)"
  echo "CLI log: $LAST_CLI_LOG"
  echo "Slots:"

  count=0
  while IFS= read -r dir; do
    [[ -n "$dir" ]] || continue
    slot="$dir/$SLOT_NAME.json"
    if [[ -f "$slot" ]]; then
      count=$((count + 1))
      if [[ -w "$slot" ]]; then
        writable_any="True"
        echo "  - $slot | exists=True | writable=True"
      else
        echo "  - $slot | exists=True | writable=False"
      fi
    else
      echo "  - $slot | exists=False | writable=False"
    fi
  done < <(candidate_scheme_dirs | awk '!seen[$0]++')

  echo "Slot count: $count"
  echo "Writable slot: $writable_any"
}

try_loop() {
  local n=1
  local ok_prepare=0

  [[ "$ATTEMPTS" =~ ^[0-9]+$ ]] || ATTEMPTS=1
  [[ "$ATTEMPTS" -lt 1 ]] && ATTEMPTS=1

  while [[ "$n" -le "$ATTEMPTS" ]]; do
    ok_prepare=0

    if [[ "$PREPARE" -eq 1 ]]; then
      prepare_slot_once && ok_prepare=1 || ok_prepare=0
    fi

    if [[ "$APPLY" -eq 1 ]]; then
      apply_scheme_once || true
    fi

    [[ "$ok_prepare" -eq 1 || "$PREPARE" -eq 0 ]] && return 0

    n=$((n + 1))
    sleep 0.25
  done

  return 1
}

if [[ "$STATUS" -eq 1 ]]; then
  status_slot
  exit 0
fi

if [[ "$PREPARE" -eq 0 && "$APPLY" -eq 0 ]]; then
  status_slot
  exit 0
fi

try_loop
status_slot
