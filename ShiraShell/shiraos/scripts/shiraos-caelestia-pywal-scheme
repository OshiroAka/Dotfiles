#!/usr/bin/env python3
import argparse, glob, hashlib, json, os, re, shutil, subprocess, tempfile, time
from pathlib import Path

CACHE = Path.home() / ".cache/shiraos"
WAL_JSON = Path.home() / ".cache/wal/colors.json"
LAST = CACHE / "caelestia-last-apply.json"

def sha_text(s):
    return hashlib.sha256(s.encode()).hexdigest()

def sha_file(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()

def clean_hex(v, fallback="ffffff"):
    v = str(v or "").strip().replace("#", "")
    return v.lower() if re.fullmatch(r"[0-9a-fA-F]{6}", v) else fallback

def read_pywal():
    if not WAL_JSON.exists():
        return None
    data = json.loads(WAL_JSON.read_text())
    special = data.get("special", {})
    colors = data.get("colors", {})
    p = {
        "background": clean_hex(special.get("background"), "101018"),
        "foreground": clean_hex(special.get("foreground"), "e8e8ec"),
    }
    for i in range(16):
        p[f"color{i}"] = clean_hex(colors.get(f"color{i}"), p["foreground"])
    return p

def palette_hash(p):
    return sha_text(json.dumps(p, sort_keys=True))

def scheme_root():
    for pat in [
        "/usr/lib/python*/site-packages/caelestia/data/schemes",
        "/usr/lib64/python*/site-packages/caelestia/data/schemes",
        str(Path.home() / ".local/lib/python*/site-packages/caelestia/data/schemes"),
    ]:
        for d in glob.glob(pat):
            if Path(d).is_dir():
                return Path(d)
    return None

def slot_path(root, slot):
    p = root / slot
    if p.exists():
        return p
    for x in root.iterdir():
        if x.name.lower() == slot.lower():
            return x
    return None

def valid_slots(root):
    return [p.name for p in sorted(root.iterdir()) if p.exists()]

def files_inside(path):
    if path.is_file():
        return [path]
    return [f for f in path.rglob("*") if f.is_file() and "__pycache__" not in str(f)]

def read_keys(path):
    keys = []
    try:
        for line in path.read_text(errors="ignore").splitlines():
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            parts = s.split()
            if len(parts) >= 2 and re.fullmatch(r"#?[0-9a-fA-F]{6}", parts[1]):
                keys.append(parts[0])
    except Exception:
        pass
    return keys

def pick_color(k, p, i):
    n = k.lower()
    bg, fg = p["background"], p["foreground"]
    c0 = p.get("color0", bg)
    c1 = p.get("color1", "ff5555")
    c2 = p.get("color2", "50fa7b")
    c3 = p.get("color3", "f1fa8c")
    c4 = p.get("color4", "8aadf4")
    c5 = p.get("color5", "f5bde6")
    c6 = p.get("color6", "8bd5ca")
    c7 = p.get("color7", fg)
    c8 = p.get("color8", c0)

    if any(x in n for x in ["background","base","mantle","crust","surface","layer","bar","panel"]): return bg
    if any(x in n for x in ["foreground","text","content","onsurface","onbackground"]): return fg
    if any(x in n for x in ["primary","accent","active","selected"]): return c5
    if "secondary" in n: return c4
    if "tertiary" in n: return c6
    if any(x in n for x in ["error","danger","red"]): return c1
    if any(x in n for x in ["success","green"]): return c2
    if any(x in n for x in ["warning","yellow"]): return c3
    if "blue" in n: return c4
    if any(x in n for x in ["purple","mauve","pink","magenta"]): return c5
    if any(x in n for x in ["cyan","teal","sky"]): return c6
    if any(x in n for x in ["outline","border"]): return c8
    if "white" in n: return c7
    if any(x in n for x in ["black","shadow"]): return c0
    return [bg, fg, c5, c4, c6, c1, c2, c3, c8, c7][i % 10]

def generate(path, palette):
    keys = read_keys(path)
    if not keys:
        return None
    out, seen = [], set()
    for i, k in enumerate(keys):
        if k in seen:
            continue
        seen.add(k)
        out.append(f"{k} {pick_color(k, palette, i)}")
    return "\n".join(out) + "\n"

def backup_slot(path, slot):
    CACHE.mkdir(parents=True, exist_ok=True)
    b = CACHE / f"caelestia-{slot}-original-backup"
    if b.exists():
        return b
    if path.is_dir():
        shutil.copytree(path, b)
    else:
        b.write_text(path.read_text(errors="ignore"))
    return b

def prepare_permissions(path, allow_sudo):
    if not allow_sudo:
        return
    user = os.environ.get("USER")
    if user:
        subprocess.run(["sudo", "chown", "-R", f"{user}:{user}", str(path)], check=False)

def write_checked(path, content, allow_sudo=False):
    if os.access(str(path), os.W_OK):
        path.write_text(content)
    elif allow_sudo:
        with tempfile.NamedTemporaryFile("w", delete=False) as f:
            f.write(content)
            tmp = f.name
        try:
            r = subprocess.run(["sudo", "install", "-m", "644", tmp, str(path)])
            if r.returncode != 0:
                return False
        finally:
            try: os.unlink(tmp)
            except Exception: pass
    else:
        print("ERRO sem permissão:", path)
        return False

    try:
        after = path.read_text(errors="ignore")
        if after != content:
            print("ERRO verificação falhou:", path)
            print("esperado:", sha_text(content))
            print("gravado: ", sha_text(after))
            return False
    except Exception as e:
        print("ERRO lendo de volta:", path, e)
        return False
    return True

def restore_terminal():
    # Volta o terminal para o pywal depois do Caelestia aplicar o scheme.
    # Isso pode dar uma piscada no terminal, mas impede o Caelestia de dominar as cores.
    if shutil.which("wal"):
        subprocess.run(["wal", "-R"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    seq = Path.home() / ".cache/wal/sequences"
    if seq.exists():
        try:
            print(seq.read_text(), end="")
        except Exception:
            pass


def apply_slot(slot, root, attempts=3, no_terminal=True):
    if not shutil.which("caelestia"):
        print("ERRO: comando caelestia não encontrado.")
        return False

    alt = None
    for name in valid_slots(root):
        if name != slot:
            alt = name
            break

    for i in range(1, attempts + 1):
        print(f"Tentativa de aplicar {i}/{attempts}")

        # Troca para outro slot antes, para forçar o Caelestia a reler o slot principal.
        if alt:
            subprocess.run(
                ["caelestia", "scheme", "set", "-n", alt],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
            time.sleep(0.25)

        r = subprocess.run(["caelestia", "scheme", "set", "-n", slot])

        # Mantém o terminal sob controle do pywal.
        # Pode piscar, mas não mata o Caelestia.
        if no_terminal:
            restore_terminal()

        if r.returncode == 0:
            print("Aplicação retornou OK.")
            return True

        time.sleep(0.5)

    print("ERRO: Caelestia não aceitou aplicar o slot.")
    return False


def update_slot(path, slot, palette, allow_sudo=False, prepare=False):
    if prepare:
        prepare_permissions(path, allow_sudo)

    backup = backup_slot(path, slot)
    files = files_inside(path)

    changed = 0
    verified = 0
    failed = 0
    generated_hashes = {}

    for f in files:
        content = generate(f, palette)
        if content is None:
            continue

        h = sha_text(content)
        generated_hashes[str(f)] = h

        CACHE.mkdir(parents=True, exist_ok=True)
        (CACHE / f"{slot}-{f.name}.generated").write_text(content)

        before = sha_file(f) if f.exists() else ""
        if write_checked(f, content, allow_sudo):
            after = sha_file(f)
            verified += 1
            if after != before:
                changed += 1
        else:
            failed += 1

    print("Backup:", backup)
    print("Arquivos verificados:", verified)
    print("Arquivos alterados:", changed)
    if failed:
        print("Falhas:", failed)
        return False, changed, generated_hashes

    return verified > 0, changed, generated_hashes

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--slot", default=os.environ.get("SHIRAOS_CAELESTIA_SLOT", "golden-dusk"))
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--prepare", action="store_true")
    ap.add_argument("--apply", action="store_true")
    ap.add_argument("--allow-sudo", action="store_true")
    ap.add_argument("--no-terminal", action="store_true")
    ap.add_argument("--force", action="store_true", help="compatibilidade; força reaplicar")
    ap.add_argument("--attempts", type=int, default=3)
    args = ap.parse_args()

    root = scheme_root()
    if not root:
        print("ERRO: não achei schemes do Caelestia.")
        return 1

    if args.list:
        print("Scheme root:", root)
        for n in valid_slots(root):
            print(" ", n)
        return 0

    path = slot_path(root, args.slot)
    if not path:
        print("ERRO: slot não encontrado:", args.slot)
        print("Use --list.")
        return 1

    pal = read_pywal()
    phash = palette_hash(pal) if pal else None

    if args.status:
        print("Scheme root:", root)
        print("Slot:", args.slot)
        print("Slot path:", path)
        print("Writable slot:", os.access(str(path), os.W_OK))
        print("Pywal cache:", WAL_JSON, "exists=" + str(WAL_JSON.exists()))
        print("Pywal hash:", phash)
        if LAST.exists():
            print("Last:", LAST.read_text())
        return 0

    if not pal:
        print("ERRO: não achei ~/.cache/wal/colors.json")
        print("Rode: wal -i /caminho/do/wallpaper")
        return 1

    print("Scheme root:", root)
    print("Slot:", args.slot)
    print("Slot path:", path)
    print("Pywal hash:", phash)

    ok, changed, generated = update_slot(path, args.slot, pal, args.allow_sudo, args.prepare)
    if not ok:
        print("ERRO: não consegui atualizar/verificar o slot.")
        return 1

    apply_ok = True
    if args.apply:
        apply_ok = apply_slot(args.slot, root, attempts=args.attempts, no_terminal=args.no_terminal)

    LAST.write_text(json.dumps({
        "slot": args.slot,
        "pywal_hash": phash,
        "changed_files": changed,
        "apply_ok": bool(apply_ok),
        "generated_files": generated,
        "time": time.time(),
    }, indent=2))

    if changed == 0:
        print("Aviso: arquivos não mudaram. Se você trocou wallpaper, talvez o pywal não tenha sido atualizado.")
    if not apply_ok:
        return 1

    return 0

if __name__ == "__main__":
    raise SystemExit(main())
