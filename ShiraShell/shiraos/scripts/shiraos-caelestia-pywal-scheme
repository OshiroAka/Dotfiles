#!/usr/bin/env bash
set -u

# shiraos-caelestia-pywal-scheme v2
#
# Prepara e aplica um scheme do Caelestia usando cores do pywal.
#
# Uso:
#   shiraos-caelestia-pywal-scheme --prepare --apply --allow-sudo --force --no-terminal --attempts 3
#   shiraos-caelestia-pywal-scheme --status

PREPARE=0
APPLY=0
STATUS=0
ALLOW_SUDO=0
FORCE=0
NO_TERMINAL=0
ATTEMPTS=1

SLOT_NAME="${SHIRAOS_CAEL_SLOT_NAME:-shiraos-pywal}"
MODE="${SHIRAOS_CAEL_MODE:-dark}"
USER_NAME="${SUDO_USER:-${USER:-$(id -un)}}"
USER_HOME="$(getent passwd "$USER_NAME" | cut -d: -f6 2>/dev/null || printf '%s' "$HOME")"

log()  { printf '%s\n' "$*"; }
ok()   { printf '✓ %s\n' "$*"; }
warn() { printf '⚠ %s\n' "$*" >&2; }
fail() { printf '✘ %s\n' "$*" >&2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prepare) PREPARE=1 ;;
    --apply) APPLY=1 ;;
    --status) STATUS=1 ;;
    --allow-sudo) ALLOW_SUDO=1 ;;
    --force) FORCE=1 ;;
    --no-terminal) NO_TERMINAL=1 ;;
    --attempts)
      shift
      ATTEMPTS="${1:-1}"
      ;;
    --attempts=*)
      ATTEMPTS="${1#*=}"
      ;;
    -h|--help)
      cat <<EOF
Uso:
  $0 --prepare --apply --allow-sudo --force --no-terminal --attempts 3
  $0 --status

Opções:
  --prepare       cria/prepara o slot do scheme
  --apply         tenta aplicar o scheme via Caelestia CLI
  --status        mostra estado, slot e cores encontradas
  --allow-sudo    permite usar sudo quando o slot fica em /etc ou /usr
  --force         reescreve o slot mesmo se ele já existir
  --attempts N    tenta prepare/apply N vezes
EOF
      exit 0
      ;;
    *)
      warn "Ignorando opção desconhecida: $1"
      ;;
  esac
  shift
done

have_pywal_colors() {
  [[ -s "$USER_HOME/.cache/wal/colors" || -s "$USER_HOME/.cache/wal/colors.json" || -s "$USER_HOME/.cache/wal/colors.sh" ]]
}

pywal_colors_file() {
  for f in \
    "$USER_HOME/.cache/wal/colors" \
    "$USER_HOME/.cache/wal/colors.json" \
    "$USER_HOME/.cache/wal/colors.sh"
  do
    [[ -s "$f" ]] && {
      printf '%s\n' "$f"
      return 0
    }
  done
  return 1
}

find_caelestia_root() {
  local root=""

  for root in \
    "${SHIRAOS_CAEL_ROOT:-}" \
    "$USER_HOME/.config/quickshell/caelestia" \
    "/etc/xdg/quickshell/caelestia" \
    "/usr/share/quickshell/caelestia" \
    "/usr/local/share/quickshell/caelestia"
  do
    [[ -n "$root" && -d "$root" ]] && {
      printf '%s\n' "$root"
      return 0
    }
  done

  # Fallback user-level. Mesmo se Caelestia não existir, o status fica claro.
  printf '%s\n' "$USER_HOME/.config/quickshell/caelestia"
}

find_scheme_dir() {
  local root="$1"
  local dir=""

  for dir in \
    "${SHIRAOS_CAEL_SCHEME_DIR:-}" \
    "$root/schemes" \
    "$root/scheme" \
    "$root/assets/schemes" \
    "$root/assets/scheme" \
    "$root/services/schemes" \
    "$USER_HOME/.config/caelestia/schemes" \
    "$USER_HOME/.local/share/caelestia/schemes"
  do
    [[ -n "$dir" && -d "$dir" ]] && {
      printf '%s\n' "$dir"
      return 0
    }
  done

  # Se não houver pasta de schemes, criaremos esta.
  printf '%s\n' "$root/schemes"
}

find_template_scheme() {
  local dir="$1"
  local file=""

  for file in \
    "$dir/default.json" \
    "$dir/dark.json" \
    "$dir/catppuccin-mocha.json" \
    "$dir/mocha.json" \
    "$dir/gruvbox.json"
  do
    [[ -f "$file" ]] && {
      printf '%s\n' "$file"
      return 0
    }
  done

  file="$(find "$dir" -maxdepth 2 -type f -name '*.json' ! -name "$SLOT_NAME.json" 2>/dev/null | head -n 1 || true)"
  [[ -n "$file" ]] && printf '%s\n' "$file"
}

is_system_path() {
  [[ "$1" == /etc/* || "$1" == /usr/* || "$1" == /opt/* ]]
}

copy_to_path() {
  local src="$1"
  local dest="$2"

  if is_system_path "$dest"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo cp "$src" "$dest"
    else
      cp "$src" "$dest"
    fi
  else
    cp "$src" "$dest"
  fi
}

make_dir() {
  local dir="$1"
  if is_system_path "$dir"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo install -d "$dir"
    else
      mkdir -p "$dir"
    fi
  else
    mkdir -p "$dir"
  fi
}

fix_slot_perms() {
  local slot="$1"

  if is_system_path "$slot"; then
    if [[ "$ALLOW_SUDO" -eq 1 ]]; then
      sudo chown "$USER_NAME:$USER_NAME" "$slot" 2>/dev/null || true
      sudo chmod 664 "$slot" 2>/dev/null || true
    else
      chmod 664 "$slot" 2>/dev/null || true
    fi
  else
    chown "$USER_NAME:$USER_NAME" "$slot" 2>/dev/null || true
    chmod 664 "$slot" 2>/dev/null || true
  fi
}

generate_scheme_json() {
  local template="$1"
  local out="$2"

  USER_HOME="$USER_HOME" SLOT_NAME="$SLOT_NAME" MODE="$MODE" TEMPLATE="$template" OUT="$out" python3 - <<'PY'
import json
import os
import re
from pathlib import Path

home = Path(os.environ["USER_HOME"])
slot_name = os.environ.get("SLOT_NAME", "shiraos-pywal")
mode = os.environ.get("MODE", "dark")
template_path = os.environ.get("TEMPLATE", "")
out_path = Path(os.environ["OUT"])

def read_pywal_colors():
    # Preferred: ~/.cache/wal/colors = one hex per line.
    colors_file = home / ".cache/wal/colors"
    if colors_file.exists():
        vals = []
        for line in colors_file.read_text(errors="ignore").splitlines():
            line = line.strip()
            if re.match(r"^#[0-9a-fA-F]{6}$", line):
                vals.append(line)
        if vals:
            while len(vals) < 16:
                vals.append(vals[-1])
            return vals[:16]

    # colors.json fallback.
    colors_json = home / ".cache/wal/colors.json"
    if colors_json.exists():
        try:
            data = json.loads(colors_json.read_text(errors="ignore"))
            vals = []
            special = data.get("special", {})
            colors = data.get("colors", {})
            for key in ["background", "foreground", "cursor"]:
                v = special.get(key)
                if isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                    vals.append(v)
            for i in range(16):
                v = colors.get(f"color{i}")
                if isinstance(v, str) and re.match(r"^#[0-9a-fA-F]{6}$", v):
                    vals.append(v)
            if vals:
                while len(vals) < 16:
                    vals.append(vals[-1])
                return vals[:16]
        except Exception:
            pass

    # colors.sh fallback.
    colors_sh = home / ".cache/wal/colors.sh"
    if colors_sh.exists():
        text = colors_sh.read_text(errors="ignore")
        vals = re.findall(r"#[0-9a-fA-F]{6}", text)
        if vals:
            while len(vals) < 16:
                vals.append(vals[-1])
            return vals[:16]

    # fallback palette
    return [
        "#11111b", "#313244", "#f38ba8", "#a6e3a1",
        "#f9e2af", "#89b4fa", "#cba6f7", "#94e2d5",
        "#bac2de", "#45475a", "#f38ba8", "#a6e3a1",
        "#f9e2af", "#89b4fa", "#cba6f7", "#cdd6f4",
    ]

c = read_pywal_colors()
bg = c[0]
fg = c[15] if len(c) > 15 else c[7]
accent = c[4] if len(c) > 4 else c[5]
surface = c[1] if len(c) > 1 else bg

base_scheme = None
if template_path and Path(template_path).exists():
    try:
        base_scheme = json.loads(Path(template_path).read_text(errors="ignore"))
    except Exception:
        base_scheme = None

if not isinstance(base_scheme, dict):
    base_scheme = {
        "name": slot_name,
        "flavour": mode,
        "mode": mode,
        "colours": {},
        "colors": {},
    }

roles = {
    "background": bg,
    "bg": bg,
    "base": bg,
    "crust": bg,
    "mantle": surface,
    "surface": surface,
    "surface0": surface,
    "surface1": c[8] if len(c) > 8 else surface,
    "surface2": c[9] if len(c) > 9 else surface,
    "foreground": fg,
    "fg": fg,
    "text": fg,
    "subtext": fg,
    "subtext0": c[7] if len(c) > 7 else fg,
    "subtext1": fg,
    "accent": accent,
    "primary": accent,
    "secondary": c[5] if len(c) > 5 else accent,
    "border": accent,
    "blue": c[5] if len(c) > 5 else accent,
    "red": c[2] if len(c) > 2 else accent,
    "green": c[3] if len(c) > 3 else accent,
    "yellow": c[4] if len(c) > 4 else accent,
    "purple": c[6] if len(c) > 6 else accent,
    "pink": c[6] if len(c) > 6 else accent,
    "mauve": c[6] if len(c) > 6 else accent,
    "teal": c[7] if len(c) > 7 else accent,
    "cyan": c[7] if len(c) > 7 else accent,
    "orange": c[3] if len(c) > 3 else accent,
}

def update_obj(obj):
    if isinstance(obj, dict):
        for k in list(obj.keys()):
            lk = str(k).lower().replace("_", "").replace("-", "")
            if isinstance(obj[k], str) and re.match(r"^#[0-9a-fA-F]{6}$", obj[k]):
                # key-based replacement
                replaced = False
                for role, val in roles.items():
                    role_key = role.lower().replace("_", "").replace("-", "")
                    if lk == role_key or role_key in lk:
                        obj[k] = val
                        replaced = True
                        break
                # If unknown hex role, keep it. Better preserve structure than destroy it.
            else:
                update_obj(obj[k])
    elif isinstance(obj, list):
        for item in obj:
            update_obj(item)

update_obj(base_scheme)

base_scheme["name"] = slot_name
base_scheme["flavour"] = mode
base_scheme["mode"] = mode

# Ensure common sections exist, because some Caelestia versions expect "colours",
# while other scripts use "colors".
for key in ["colours", "colors"]:
    if not isinstance(base_scheme.get(key), dict):
        base_scheme[key] = {}
    base_scheme[key].update({
        "background": bg,
        "foreground": fg,
        "accent": accent,
        "primary": accent,
        "surface": surface,
        "base": bg,
        "text": fg,
        "border": accent,
        "red": roles["red"],
        "green": roles["green"],
        "yellow": roles["yellow"],
        "blue": roles["blue"],
        "purple": roles["purple"],
        "pink": roles["pink"],
        "cyan": roles["cyan"],
    })

out_path.write_text(json.dumps(base_scheme, indent=2, ensure_ascii=False) + "\n")
PY
}

prepare_slot_once() {
  local root dir slot template tmp

  root="$(find_caelestia_root)"
  dir="$(find_scheme_dir "$root")"
  slot="$dir/$SLOT_NAME.json"
  template="$(find_template_scheme "$dir" || true)"

  make_dir "$dir"

  if [[ ! -f "$slot" || "$FORCE" -eq 1 ]]; then
    tmp="$(mktemp)"
    generate_scheme_json "$template" "$tmp"
    copy_to_path "$tmp" "$slot"
    rm -f "$tmp"
  else
    # Mesmo sem --force, atualiza o conteúdo com as cores atuais do pywal.
    tmp="$(mktemp)"
    generate_scheme_json "$slot" "$tmp"
    copy_to_path "$tmp" "$slot"
    rm -f "$tmp"
  fi

  fix_slot_perms "$slot"

  if [[ -f "$slot" && -w "$slot" ]]; then
    ok "Writable slot: True"
    return 0
  fi

  warn "Writable slot: False"
  return 1
}

apply_scheme_once() {
  if ! command -v caelestia >/dev/null 2>&1; then
    warn "Comando caelestia não encontrado; prepare foi feito, apply foi pulado."
    return 0
  fi

  # Variações conhecidas do CLI.
  caelestia scheme set -n "$SLOT_NAME" -m "$MODE" >/dev/null 2>&1 && {
    ok "Scheme aplicado: $SLOT_NAME ($MODE)"
    return 0
  }

  caelestia scheme set -n "$SLOT_NAME" >/dev/null 2>&1 && {
    ok "Scheme aplicado: $SLOT_NAME"
    return 0
  }

  caelestia scheme set "$SLOT_NAME" >/dev/null 2>&1 && {
    ok "Scheme aplicado: $SLOT_NAME"
    return 0
  }

  warn "Não consegui aplicar via Caelestia CLI. O slot foi preparado mesmo assim."
  warn "Teste manual:"
  warn "  caelestia scheme set -n $SLOT_NAME -m $MODE"
  return 0
}

status_slot() {
  local root dir slot writable pywal_file template

  root="$(find_caelestia_root)"
  dir="$(find_scheme_dir "$root")"
  slot="$dir/$SLOT_NAME.json"
  template="$(find_template_scheme "$dir" || true)"

  if [[ -f "$slot" && -w "$slot" ]]; then
    writable="True"
  else
    writable="False"
  fi

  pywal_file="$(pywal_colors_file || true)"

  cat <<EOF
Caelestia root: $root
Scheme dir: $dir
Template scheme: ${template:-None}
Slot name: $SLOT_NAME
Slot file: $slot
Slot exists: $([[ -f "$slot" ]] && echo True || echo False)
Writable slot: $writable
Pywal colors: $([[ -n "$pywal_file" ]] && echo True || echo False)
Pywal source: ${pywal_file:-None}
Caelestia CLI: $(command -v caelestia >/dev/null 2>&1 && echo True || echo False)
EOF
}

try_loop() {
  local n=1
  local ok_prepare=0

  [[ "$ATTEMPTS" =~ ^[0-9]+$ ]] || ATTEMPTS=1
  [[ "$ATTEMPTS" -lt 1 ]] && ATTEMPTS=1

  while [[ "$n" -le "$ATTEMPTS" ]]; do
    ok_prepare=0

    if [[ "$PREPARE" -eq 1 ]]; then
      prepare_slot_once && ok_prepare=1 || ok_prepare=0
    fi

    if [[ "$APPLY" -eq 1 ]]; then
      apply_scheme_once || true
    fi

    [[ "$ok_prepare" -eq 1 || "$PREPARE" -eq 0 ]] && return 0

    n=$((n + 1))
    sleep 0.25
  done

  return 1
}

if [[ "$STATUS" -eq 1 ]]; then
  status_slot
  exit 0
fi

if [[ "$PREPARE" -eq 0 && "$APPLY" -eq 0 ]]; then
  status_slot
  exit 0
fi

try_loop
status_slot
