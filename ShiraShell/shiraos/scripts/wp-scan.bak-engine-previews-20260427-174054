#!/usr/bin/env bash
set -euo pipefail

printf 'BEGIN\n'

find "$HOME/Pictures/Wallpapers/static" -maxdepth 1 -type f \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
  2>/dev/null | sort | while IFS= read -r f; do
  printf 'STATIC|%s\n' "$f"
done

find "$HOME/Pictures/Wallpapers/live" -maxdepth 1 -type f \
  \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' -o -iname '*.gif' \) \
  2>/dev/null | sort | while IFS= read -r f; do
  printf 'LIVE|%s\n' "$f"
done

find "$HOME/Pictures/Wallpapers/WallpaperSelector" -maxdepth 1 -type f \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
  2>/dev/null | sort | while IFS= read -r f; do
  printf 'BG|%s\n' "$f"
done

BASE="$HOME/.steam/steam/steamapps/workshop/content/431960"
if [ -d "$BASE" ]; then
  for d in "$BASE"/*/; do
    [ -d "$d" ] || continue
    id="$(basename "$d")"
    prev="$(find "$d" -maxdepth 1 -type f \( -iname 'preview.*' -o -iname '*.jpg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | head -1 || true)"
    printf 'ENGINE|%s|%s\n' "$id" "$prev"
  done
fi

printf 'END\n'
