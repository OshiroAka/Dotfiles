#!/usr/bin/env bash

# Resolve caminho real mesmo se o script estiver linkado em ~/.local/bin
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." >/dev/null 2>&1 && pwd)"

GIF_DIR="$BASE_DIR/gif_fastfetch"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
LAST_FILE="$CACHE_DIR/shira-fetch-last-gif"

# Ajustes visuais
IMG_W=30
IMG_H=16
IMG_X=0
IMG_Y=2
TEXT_PAD=35

mkdir -p "$CACHE_DIR"

# Reaplica paleta do pywal/pywal16 no terminal atual
if [[ -r "$HOME/.cache/wal/sequences" ]]; then
  cat "$HOME/.cache/wal/sequences"
fi

mapfile -d '' GIFS < <(find "$GIF_DIR" -maxdepth 1 -type f -iname "*.gif" -print0 2>/dev/null)

if (( ${#GIFS[@]} == 0 )); then
  command fastfetch --pipe false
  exit 0
fi

LAST_GIF="$(cat "$LAST_FILE" 2>/dev/null || true)"
CANDIDATES=()

for gif in "${GIFS[@]}"; do
  if [[ "$gif" != "$LAST_GIF" ]]; then
    CANDIDATES+=("$gif")
  fi
done

if (( ${#CANDIDATES[@]} == 0 )); then
  CANDIDATES=("${GIFS[@]}")
fi

GIF="${CANDIDATES[$RANDOM % ${#CANDIDATES[@]}]}"
printf '%s' "$GIF" > "$LAST_FILE"

clear

if [[ "$TERM" == xterm-kitty* ]] && command -v kitten >/dev/null 2>&1 && [[ -f "$GIF" ]]; then
  kitten icat \
    --stdin=no \
    --transfer-mode=stream \
    --place "${IMG_W}x${IMG_H}@${IMG_X}x${IMG_Y}" \
    --scale-up \
    --align left \
    "$GIF"

  printf '\033[H'

  command fastfetch --logo none --pipe false | sed "s/^/$(printf '%*s' "$TEXT_PAD")/"

  echo
else
  command fastfetch --pipe false
fi
