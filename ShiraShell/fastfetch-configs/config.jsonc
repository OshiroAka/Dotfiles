{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/shira.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },

  "modules": [
    {
      "type": "title",
      "key": " "
    },
    {
      "type": "custom",
      "format": "╭────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  os"
    },
    {
      "type": "kernel",
      "key": "  kernel"
    },
    {
      "type": "uptime",
      "key": "  uptime"
    },
    {
      "type": "packages",
      "key": "  pkgs"
    },
    {
      "type": "shell",
      "key": "  shell"
    },
    {
      "type": "terminal",
      "key": "  term"
    },
    {
      "type": "wm",
      "key": "  wm"
    },
    {
      "type": "cpu",
      "key": "  cpu"
    },
    {
      "type": "gpu",
      "key": "  gpu"
    },
    {
      "type": "memory",
      "key": "  ram"
    },
    {
      "type": "disk",
      "key": "  disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "  battery"
    },
    {
      "type": "custom",
      "format": "├────────────────────────────┤"
    },
    {
      "type": "colors",
      "key": "  palette",
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────╯"
    }
  ]
}
